# =============================================================================
# Обязательные настройки
# =============================================================================

# Секретный ключ Django — сгенерируй уникальный:
# python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=замени-на-случайную-строку

# Домен(ы) форума через запятую
DJANGO_ALLOWED_HOSTS=forum.example.com

# =============================================================================
# База данных PostgreSQL
# =============================================================================

POSTGRES_HOST=postgres
POSTGRES_DB=misago
POSTGRES_USER=misago
POSTGRES_PASSWORD=замени-на-надёжный-пароль

# =============================================================================
# Redis
# =============================================================================

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# =============================================================================
# Email
# =============================================================================

DEFAULT_FROM_EMAIL=Forums <noreply@forum.example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
